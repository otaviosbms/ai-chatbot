PORT=3000
# Conexão com o Postgres. No Docker (ai-chatbot-infra), o compose troca o host por postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chatbot
DB_PASSWORD=chatbot
DB_NAME=chatbot
# true aplica as migrations pendentes quando a API sobe (útil no Docker).
DB_MIGRATIONS_RUN=false
# Tentativas de conexão ao subir, enquanto o banco ainda inicia.
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY_MS=3000

# Login do painel. JWT_SECRET assina os tokens (mínimo 32 caracteres; gere com: openssl rand -hex 32).
# Trocar o valor desconecta todo mundo. Sem ele a API não sobe.
JWT_SECRET=
# Padrão true: o painel mostra "Criar uma conta" e qualquer pessoa cria empresa e conta.
# Em servidor público com LLM_MODO=servidor, cada empresa nova usa a chave da OpenAI do servidor:
# nesse caso prefira false e crie as contas com: npm run usuario:criar
REGISTRO_ABERTO=true

# Origens do front que podem chamar a API, separadas por vírgula (ex.: https://aichatbot.otaviosbms.com.br). Vazio libera só localhost e 127.0.0.1, em qualquer porta.
CORS_ORIGIN=

# Modo de uso da OpenAI, lido pela API e pelo front:
#   servidor: a API usa LLM_API_KEY e LLM_MODEL abaixo; o front não pede nada.
#   cliente:  o front pede a chave de quem usa e o modelo; LLM_API_KEY e LLM_MODEL são ignorados (bom para demo pública).
LLM_MODO=servidor

# Adaptador OpenAI-compatível (Chat Completions).
LLM_BASE_URL=https://api.openai.com/v1
# Só no modo servidor.
LLM_API_KEY=
LLM_MODEL=

# Modelo de embedding do RAG da base de conhecimento. Fixo no servidor; usa a mesma chave do chat
# (LLM_API_KEY no modo servidor, a chave de quem usa no modo cliente). Trocar exige reindexar a base.
EMBEDDING_MODEL=text-embedding-3-small
